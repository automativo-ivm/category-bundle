{
    "name": "flagbit/category-bundle",
    "description": "Add new attributes to your Akeneo PIM categories and configure categories the way you need them.",
    "type": "library",
    "keywords": ["akeneo", "category", "pim", "categories"],
    "license": "MIT",
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Flagbit\\Bundle\\CategoryBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Flagbit\\Bundle\\CategoryBundle\\Tests\\": "tests/",
            "AkeneoTest\\": "vendor/akeneo/pim-community-dev/tests/back"
        }
    },
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "akeneo/pim-community-dev": "^7.0",
        "justinrainbow/json-schema": "^5.2"
    },
    "require-dev": {
        "friends-of-phpspec/phpspec-code-coverage": "^6.0",
        "phpspec/phpspec": "^7.0",
        "phpstan/phpstan": "^1.0",
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "^3.6",
        "overtrue/phplint": "^5.0",
        "symfony/debug-bundle": "^5.4",
        "symfony/web-profiler-bundle": "^5.4",
        "doctrine/coding-standard": "^12.0"
    }
}
